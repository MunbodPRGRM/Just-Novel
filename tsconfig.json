{
  "compilerOptions": {
    // Next แปลงโค้ดด้วย SWC เองอยู่แล้ว ตรงนี้แค่บอก tsc ว่า target เป็นเบราว์เซอร์ยุคใหม่
    // (ค่า default ของ tsc คือ ES5 ซึ่งห้าม for...of บน Map/Set)
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
